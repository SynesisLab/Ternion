{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ternion",
  "version": "0.1.0",
  "identifier": "com.paperplane.ternion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ternion",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#0b0e14",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/attachments/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "TradChinese"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SynesisLab/Ternion/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_PUBLIC_KEY_FROM_TAURI_SIGNER",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}